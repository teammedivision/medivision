# MediVision environment configuration.
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# --- Secrets (REQUIRED in production) --------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Defaults to SECRET_KEY if empty.
JWT_SECRET_KEY=
# Login token lifetime.
JWT_EXPIRES_HOURS=24

# --- Database ---------------------------------------------------------------
# Empty = SQLite at api/data/medivision.db (fine for dev / small deployments).
# Production example: postgresql://medivision:password@db:5432/medivision
DATABASE_URL=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Add your real domain(s).
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_ANALYZE=10 per minute
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=3 per minute
# For multi-instance deployments use redis, e.g. redis://localhost:6379
RATE_LIMIT_STORAGE=memory://

# --- Out-of-distribution gate ----------------------------------------------
# Reject images the domain router isn't confident about. Tune on validation data.
OOD_MIN_DOMAIN_CONFIDENCE=0.70
OOD_MAX_ENTROPY=0.90

# --- Behaviour --------------------------------------------------------------
# Require the consent form field before analysis (keep true in production).
REQUIRE_CONSENT=true

# --- Observability ----------------------------------------------------------
# Create a free project at sentry.io and paste the DSN to get error alerts.
SENTRY_DSN=
